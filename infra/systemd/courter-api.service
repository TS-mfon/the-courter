[Unit]
Description=The Courter FastAPI service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/the-courter
EnvironmentFile=/opt/the-courter/.env.production
ExecStart=/opt/the-courter/.venv/bin/uvicorn apps.api.courter_api.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
